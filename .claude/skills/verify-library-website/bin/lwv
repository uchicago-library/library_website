#!/usr/bin/env bash
# lwv: launch, inspect, drive and tear down isolated verification instances
# of the library website. Run `lwv help` for usage.
#
# Each `up` clones the fixture-loaded database lib_www_verify_tpl into its own
# database and starts a throwaway web container (compose service `web`, name
# lwv-<run>) on the first free port in 8010-8029. Run state is stored in
# $STATE_ROOT/runs/<id>/state.env. db and redis are the shared compose
# services. The developer's web container, port 8000, and lib_www_dev database
# are left alone. `browse` and `node` run Playwright from ../lib against the
# instance.
set -euo pipefail

# Git Bash rewrites arguments that look like POSIX paths (/venv/bin/python,
# /borrow/) when it starts Windows programs. Turn that off and hand those
# programs Windows-form host paths (C:/...) instead.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL="*"
native_path() {
  if command -v cygpath >/dev/null; then cygpath -m "$1"; else echo "$1"; fi
}

SKILL_DIR="$(native_path "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)")"
REPO="$(git -C "$SKILL_DIR" rev-parse --show-toplevel)"

# Optional, gitignored service credentials (see SKILL.md).
if [[ -f "$SKILL_DIR/.env" ]]; then
  set -a; source "$SKILL_DIR/.env"; set +a
fi
# Per-run state (kept after `down`) and the Playwright install (outside the repo).
STATE_ROOT="$(native_path "${LWV_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/lw-verify}")"
NODE_DIR="$(native_path "${XDG_CACHE_HOME:-$HOME/.cache}/lw-verify/node")"
PLAYWRIGHT_VERSION="1.63.0"
# Database `up` clones. Its comment is the fixture hash from the last build.
TEMPLATE_DB="lib_www_verify_tpl"
FIXTURE="base/fixtures/test.json"
# psql in the shared compose Postgres, as the vagrant role, tuples only.
PG=(docker compose exec -T db psql -U vagrant -d postgres -qAt -v ON_ERROR_STOP=1)

cd "$REPO"

die() { echo "lwv: $*" >&2; exit 1; }
log() { echo "lwv: $*" >&2; }

# Help text. Each subcommand is a function named cmd_<name>. The case
# statement at the bottom of this file dispatches to them. rebuild-template
# calls build_template directly.
usage() {
  cat <<'EOF'
Usage: lwv <command> [args]

  up                      Start a new isolated instance (prints run id, URLs, artifacts dir)
  doctor                  Read-only health check of the selected run
  env                     Print the selected run's state (URLs, admin login, paths)
  manage <args...>        Run manage.py inside the run's container
  sql "<query>"           Run SQL against the run's database
  browse <url> [opts]     Load a page in Chromium and capture evidence
                            --shot FILE   full-page PNG
                            --aria FILE   ARIA snapshot of <body>
                            --html FILE   rendered DOM
                            --login       sign in to Wagtail admin first
                            --wait SEL    wait for a CSS selector before capture
  node <script.mjs>       Run a custom Playwright script (import from $LWV_LIB/lwv.mjs)
  down                    Tear down the selected run (artifacts are kept)
  list                    List runs and whether they are up
  rebuild-template        Drop and rebuild the fixture-loaded template database

Paths are relative to the repo root. URLs may be absolute or paths on the
public site; prefix a path with "loop:" for the intranet (e.g. loop:/).
For browse and node, LWV_WALKTHROUGH=1 shows the browser and pauses at each
step() until Next is clicked; LWV_HEADED=1 only shows the browser.
Select a run with LWV_RUN=<id>; default is the most recent `lwv up`.
EOF
}

# --- Select a run and see if its container is up

# Load state.env for $LWV_RUN, or for the id written by the latest `up`.
select_run() {
  local run="${LWV_RUN:-}"
  if [[ -z "$run" ]]; then
    [[ -f "$STATE_ROOT/current-run" ]] || die "no runs yet; use 'lwv up'"
    run="$(<"$STATE_ROOT/current-run")"
  fi
  RUN_DIR="$STATE_ROOT/runs/$run"
  [[ -f "$RUN_DIR/state.env" ]] || die "unknown run '$run'"
  # shellcheck disable=SC1091
  source "$RUN_DIR/state.env"
}

# True when the selected run's container is running. $CONTAINER comes from state.env.
container_running() {
  [[ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" == "true" ]]
}

# --- Build or reuse the fixture-loaded Postgres template

# First 16 hex chars of the fixture file. Stored as the template database's
# comment so a fixture edit triggers a rebuild.
fixture_sum() {
  if command -v sha256sum >/dev/null; then sha256sum "$FIXTURE"; else shasum -a 256 "$FIXTURE"; fi | cut -c1-16
}

# The comment on $TEMPLATE_DB: the fixture hash from the last build, or empty.
template_sum() {
  "${PG[@]}" -c "SELECT shobj_description(oid, 'pg_database') FROM pg_database WHERE datname='$TEMPLATE_DB'"
}

# Run one bash command in a throwaway web container against <db>.
# verify_settings is mounted at /verify. No port is published.
# run_oneoff <db> <bash command>
run_oneoff() {
  docker compose run --rm --no-deps -T \
    -v "$SKILL_DIR/lib:/verify:ro" \
    -e PYTHONPATH=/verify -e DJANGO_SETTINGS_MODULE=verify_settings \
    -e DIRECTORY_USERNAME -e DIRECTORY_PASSWORD -e DIRECTORY_WEB_SERVICE \
    -e MARKLOGIC_LDR_USER -e MARKLOGIC_LDR_PASSWORD -e MARKLOGIC_LDR_URL -e SPARQL_ROOT \
    -e LWV_RUN=template -e LWV_DB="$1" -e LWV_PORT=8000 \
    web bash -c "source /venv/bin/activate && cd /app && $2"
}

# Drop $TEMPLATE_DB and load the fixture into a fresh one. Several minutes.
build_template() {
  log "building template database $TEMPLATE_DB from $FIXTURE (one-time, several minutes)"
  "${PG[@]}" -c "DROP DATABASE IF EXISTS $TEMPLATE_DB"
  "${PG[@]}" -c "CREATE DATABASE $TEMPLATE_DB"
  # migrate, load the fixture, remove the default localhost Site migrate
  # creates, then build the database search index.
  run_oneoff "$TEMPLATE_DB" "python manage.py migrate --noinput && \
    python manage.py loaddata $FIXTURE && \
    python manage.py shell -c \"from wagtail.models import Site; Site.objects.filter(hostname='localhost').delete()\" && \
    python manage.py update_index"
  "${PG[@]}" -c "COMMENT ON DATABASE $TEMPLATE_DB IS '$(fixture_sum)'"
}

# Build the template on first use, and again when the fixture hash changes.
ensure_template() {
  local have
  have="$(template_sum)"
  if [[ -z "$have" ]]; then
    build_template
  elif [[ "$have" != "$(fixture_sum)" ]]; then
    log "fixture changed since template was built; rebuilding"
    build_template
  fi
}

# --- Start shared services, find a free port, check hostnames

# Start compose db and redis when they are down. STARTED_DEPS=1 lets `down`
# stop them later, and only when nothing else is using them.
ensure_deps() {
  STARTED_DEPS=0
  local running
  running="$(docker compose ps --status running --services 2>/dev/null || true)"
  if ! grep -qx db <<<"$running" || ! grep -qx redis <<<"$running"; then
    log "starting db and redis"
    docker compose up -d db redis >&2
    STARTED_DEPS=1
  fi
  until docker compose exec -T db pg_isready -U vagrant -q; do sleep 2; done
}

# First port in 8010-8029 that accepts no connection. `up` binds it to 127.0.0.1.
free_port() {
  local p
  for p in $(seq 8010 8029); do
    if ! (exec 3<>"/dev/tcp/127.0.0.1/$p") 2>/dev/null; then echo "$p"; return; fi
  done
  die "no free port in 8010-8029"
}

# Exit 0 when the hostname resolves. `up` requires wwwdev and loopdev.
resolves() {
  node -e 'require("dns").lookup(process.argv[1], (err) => process.exit(err ? 1 : 0))' "$1"
}

# --- Subcommands, one cmd_<name> function each

cmd_up() {
  # wwwdev and loopdev must point at this machine (see the hosts note in SKILL.md).
  resolves wwwdev && resolves loopdev \
    || die "wwwdev and loopdev must resolve to 127.0.0.1 (see the hosts file in SKILL.md)"
  # Shared db and redis, then the fixture template (built once, then reused).
  ensure_deps
  ensure_template

  # Run id, port, database name, container name, admin password, and state dir.
  local run port db container pass
  run="$(date +%Y%m%d-%H%M%S)"
  port="$(free_port)"
  db="lwv_${run//-/_}"
  container="lwv-$run"
  pass="$(head -c 18 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')"
  RUN_DIR="$STATE_ROOT/runs/$run"
  mkdir -p "$RUN_DIR/artifacts"
  chmod 700 "$RUN_DIR"

  # Record the run. Later commands load this file through select_run.
  cat >"$RUN_DIR/state.env" <<EOF
RUN=$run
PORT=$port
DB=$db
CONTAINER=$container
PUBLIC_URL=http://wwwdev:$port
LOOP_URL=http://loopdev:$port
ADMIN_USER=lwv_admin
ADMIN_PASS=$pass
ARTIFACTS=$RUN_DIR/artifacts
GIT_REV=$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty)
STARTED_DEPS=$STARTED_DEPS
EOF
  chmod 600 "$RUN_DIR/state.env"
  echo "$run" >"$STATE_ROOT/current-run"

  # Clone the template in place. The new database is independent after this.
  log "cloning $TEMPLATE_DB -> $db"
  "${PG[@]}" -c "CREATE DATABASE $db TEMPLATE $TEMPLATE_DB"

  # Throwaway container: migrate, point every Site at this port, create
  # lwv_admin in the Library group, then runserver. --rm removes it on stop.
  log "starting container $container on port $port"
  docker compose run -d --rm --no-deps --name "$container" \
    -p "127.0.0.1:$port:$port" \
    -v "$SKILL_DIR/lib:/verify:ro" \
    -e PYTHONPATH=/verify -e DJANGO_SETTINGS_MODULE=verify_settings \
    -e DIRECTORY_USERNAME -e DIRECTORY_PASSWORD -e DIRECTORY_WEB_SERVICE \
    -e MARKLOGIC_LDR_USER -e MARKLOGIC_LDR_PASSWORD -e MARKLOGIC_LDR_URL -e SPARQL_ROOT \
    -e LWV_RUN="$run" -e LWV_DB="$db" -e LWV_PORT="$port" \
    -e LWV_ADMIN_PASS="$pass" \
    web bash -c "source /venv/bin/activate && cd /app && \
      python manage.py migrate --noinput && \
      python manage.py shell -c \"
import os
from django.contrib.auth.models import Group, User
from wagtail.models import Site
Site.objects.update(port=$port)
User.objects.filter(username='lwv_admin').delete()
u = User.objects.create_superuser('lwv_admin', '', os.environ['LWV_ADMIN_PASS'])
u.groups.add(*Group.objects.filter(name='Library'))
\" && echo LWV_READY_TO_SERVE && \
      exec python manage.py runserver 0.0.0.0:$port" >/dev/null

  # Wait until the public homepage returns 200. On an early exit, keep the log.
  log "waiting for http://wwwdev:$port/"
  local i code
  for i in $(seq 1 120); do
    container_running_name "$container" || {
      docker logs "$container" >"$RUN_DIR/artifacts/server.log" 2>&1 || true
      die "container exited during startup; see $RUN_DIR/artifacts/server.log"
    }
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "http://wwwdev:$port/" || true)"
    [[ "$code" == "200" ]] && break
    sleep 3
  done
  [[ "$code" == "200" ]] || die "instance did not answer 200 (last: $code); 'lwv down' to clean up"

  echo "RUN=$run"
  echo "PUBLIC_URL=http://wwwdev:$port"
  echo "LOOP_URL=http://loopdev:$port"
  echo "ADMIN_URL=http://wwwdev:$port/admin/"
  echo "ARTIFACTS=$RUN_DIR/artifacts"
}

# True when a named container is running. Used during startup, before
# select_run, and by `list`.
container_running_name() {
  [[ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" == "true" ]]
}

# Read-only. One ok/FAIL line per check, then exit 1 if any check failed.
cmd_doctor() {
  select_run
  local ok=1 code rev
  check() { if eval "$2"; then echo "ok    $1"; else echo "FAIL  $1"; ok=0; fi; }
  echo "run $RUN  port $PORT  db $DB  container $CONTAINER"
  # Container identity: running, created for this run, and publishing this port.
  check "container $CONTAINER is running" container_running
  check "container belongs to run $RUN" \
    "[[ \"\$(docker exec $CONTAINER printenv LWV_RUN 2>/dev/null)\" == '$RUN' ]]"
  check "port $PORT is published by $CONTAINER" \
    "docker port $CONTAINER $PORT/tcp 2>/dev/null | grep -q ':$PORT'"
  check "app reports database $DB" \
    "docker exec $CONTAINER /venv/bin/python -c \"import os; os.environ['DJANGO_SETTINGS_MODULE']='verify_settings'; import django; django.setup(); from django.conf import settings; assert settings.DATABASES['default']['NAME']=='$DB'\" 2>/dev/null"
  # Public homepage and the admin login answer 200. Anonymous Loop is redirected.
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$PUBLIC_URL/" || true)"
  check "public site $PUBLIC_URL/ answers 200 (got $code)" "[[ $code == 200 ]]"
  code="$(curl -s -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 20 "$LOOP_URL/" || true)"
  check "intranet $LOOP_URL/ gates anonymous users (got $code)" \
    "[[ '$code' == '302 https://www.lib.uchicago.edu/no-permission/' ]]"
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$PUBLIC_URL/admin/login/" || true)"
  check "admin login page answers 200 (got $code)" "[[ $code == 200 ]]"
  # The checkout may have changed since launch. That is a warning, not a failure.
  rev="$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo -dirty)"
  if [[ "$rev" == "$GIT_REV" ]]; then
    echo "ok    checkout $rev matches launch"
  else
    echo "WARN  checkout is $rev, launched at $GIT_REV (runserver reloads edits; label evidence with $rev)"
  fi
  [[ $ok == 1 ]] || exit 1
}

# Print state.env for the selected run, including ADMIN_PASS.
cmd_env() { select_run; cat "$RUN_DIR/state.env"; }

# Run manage.py inside the selected run's container.
cmd_manage() {
  select_run
  container_running || die "container $CONTAINER is not running"
  docker exec -i "$CONTAINER" bash -c 'source /venv/bin/activate && cd /app && python manage.py "$@"' _ "$@"
}

# Run one SQL statement against the selected run's database.
cmd_sql() {
  select_run
  docker compose exec -T db psql -U vagrant -d "$DB" -P pager=off -c "$1"
}

# Install Playwright into $NODE_DIR (outside the repo) and download Chromium.
ensure_playwright() {
  if [[ ! -d "$NODE_DIR/node_modules/playwright" ]]; then
    log "installing playwright@$PLAYWRIGHT_VERSION into $NODE_DIR"
    mkdir -p "$NODE_DIR"
    npm install --silent --prefix "$NODE_DIR" "playwright@$PLAYWRIGHT_VERSION" >&2
  fi
  "$NODE_DIR/node_modules/.bin/playwright" install chromium >&2
}

# Export LWV_* for Playwright scripts. NODE_PATH lets them require playwright.
node_env() {
  export LWV_RUN="$RUN" LWV_PORT="$PORT" LWV_PUBLIC_URL="$PUBLIC_URL" \
    LWV_LOOP_URL="$LOOP_URL" LWV_ADMIN_USER="$ADMIN_USER" \
    LWV_ADMIN_PASS="$ADMIN_PASS" LWV_ARTIFACTS="$ARTIFACTS" \
    LWV_LIB="$SKILL_DIR/lib" LWV_BIN="$SKILL_DIR/bin/lwv" \
    NODE_PATH="$NODE_DIR/node_modules"
}

# Open one page in Chromium. Implementation: lib/browse.mjs.
cmd_browse() {
  select_run
  ensure_playwright
  node_env
  node "$SKILL_DIR/lib/browse.mjs" "$@"
}

# Run a caller-supplied Playwright script with the LWV_* environment set.
cmd_node() {
  select_run
  ensure_playwright
  node_env
  [[ $# -ge 1 ]] || die "usage: lwv node <script.mjs> [args]"
  node "$@"
}

# Stop the run's container, drop its database and Redis keys, and keep artifacts.
cmd_down() {
  select_run
  # Save runserver output, then stop. docker rm clears a container that already exited.
  if container_running; then
    docker logs "$CONTAINER" >"$ARTIFACTS/server.log" 2>&1 || true
    docker stop "$CONTAINER" >/dev/null
    log "stopped $CONTAINER (server log saved to $ARTIFACTS/server.log)"
  fi
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  # This run's database only. The template and lib_www_dev stay.
  "${PG[@]}" -c "DROP DATABASE IF EXISTS $DB WITH (FORCE)"
  # Keys are prefixed lwv-<run>: on Redis database 7 (see verify_settings.py).
  docker compose exec -T redis sh -c \
    "redis-cli -n 7 --scan --pattern 'lwv-$RUN:*' | xargs -r redis-cli -n 7 del >/dev/null"
  # Stop db and redis only if this run started them and no other lwv or web
  # container is still using them.
  if [[ "$STARTED_DEPS" == "1" ]]; then
    local others
    others="$(docker ps --filter name=lwv- -q | wc -l)"
    if [[ "$others" == "0" ]] && ! docker compose ps --status running --services | grep -qx web; then
      docker compose stop db redis >&2
      log "stopped db and redis (started by this run)"
    else
      log "leaving db and redis up (in use by other containers)"
    fi
  fi
  # state.env stays so `list` can still find the artifacts directory.
  grep -qx STATE=down "$RUN_DIR/state.env" || echo "STATE=down" >>"$RUN_DIR/state.env"
  echo "ARTIFACTS=$ARTIFACTS"
}

# One line per run: id, up or down, and the public URL or artifacts path.
cmd_list() {
  local d run name
  [[ -d "$STATE_ROOT/runs" ]] || { echo "no runs"; return; }
  for d in "$STATE_ROOT"/runs/*; do
    run="$(basename "$d")"
    name="lwv-$run"
    if container_running_name "$name"; then echo "$run  up    $(grep ^PUBLIC_URL= "$d/state.env" | cut -d= -f2)"
    else echo "$run  down  $d/artifacts"; fi
  done
}

case "${1:-help}" in
  up) shift; cmd_up "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  env) shift; cmd_env "$@" ;;
  manage) shift; cmd_manage "$@" ;;
  sql) shift; cmd_sql "$@" ;;
  browse) shift; cmd_browse "$@" ;;
  node) shift; cmd_node "$@" ;;
  down) shift; cmd_down "$@" ;;
  list) shift; cmd_list "$@" ;;
  rebuild-template) shift; ensure_deps; build_template ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
